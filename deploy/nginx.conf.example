# Replace the example domain and TLS file paths with your own values.
server {
    listen 80;
    server_name cert.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name cert.example.com;
    ssl_certificate /etc/nginx/tls/cert.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/cert.example.com/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 400k;

    location / {
        proxy_pass http://127.0.0.1:18090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, rather than append to, an untrusted client-supplied header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }

    location = /api/auth/feishu/callback {
        access_log off;
        proxy_pass http://127.0.0.1:18090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
}
