# Run python3 ops/init.py to generate unique secrets in .env.
# This file contains placeholders and is not a ready-to-run configuration.
PUBLIC_URL=http://127.0.0.1:18090
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18090
POSTGRES_PASSWORD=GENERATE_WITH_OPS_INIT
DATABASE_PASSWORD=GENERATE_WITH_OPS_INIT
ENCRYPTION_KEY=GENERATE_WITH_OPS_INIT
ADMIN_PASSWORD=GENERATE_WITH_OPS_INIT
FORWARDED_ALLOW_IPS=127.0.0.1
TZ=Asia/Shanghai

# Optional Feishu login. Every allowed member has full administrator access.
# Leave all four values empty to use only the local administrator account.
# PUBLIC_URL must be an HTTPS origin when Feishu login is enabled.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# Comma-separated OpenIDs for this app, not user IDs or union IDs.
FEISHU_ALLOWED_OPEN_IDS=
